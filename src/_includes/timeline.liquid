<ul class="timeline">
   <li class="timeline__topitem"></li>
   {% for item in timeline %}
   {% if item.next %}
      <li class="timeline__item">
         <div class="timeline__item_year">{{ item.year }}</div>
         <div class="timeline__item_place">{{ item.place }}</div>
         {% if item.url %}
         <div class="timeline__item_link"><a href="{{ item.url }}">Conference web-site</a></div>
         {% else %}
         <div class="timeline__item_info">Coming soon...</div>
         {% endif %}
      </li>
   {% else %}
      <li class="timeline__item">
         <div class="timeline__item_year">{{ item.year }}</div>
         <div class="timeline__item_place">{{ item.place }}</div>

         <div class="timeline__item_info">{{ item.info }}</div>
         {% if item.assets  %}
            {%  for asset in item.assets %}
            <div class="timeline__item_link"><a class="pdf" href="{{ asset.url }}">{{ asset.name }}</a></div>
            {% endfor %}
         {% endif %}
      </li>
   {% endif %}
   {% endfor %}
</ul>